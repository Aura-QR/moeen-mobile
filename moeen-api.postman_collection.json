{
  "info": {
    "_postman_id": "Haddher-backend-api-collection-2026",
    "name": "Haddher Backend API",
    "description": "Complete Postman collection for testing the Haddher Backend API (Laravel 11 + Sanctum).\n\nBased on postman_endpoints_test_doc.md and actual routes/controllers.\n\n## Quick Start\n1. Set `base_url` variable (default: http://127.0.0.1:8000)\n2. Register or Login first to obtain a token\n3. Token is automatically saved to collection variables\n4. Use `Authorization: Bearer {{token}}` on protected routes (already configured)\n\n## Prerequisites\n- Run `php artisan serve`\n- Database seeded with at least one teacher + free subscription plan\n- For Madrasati flows: valid session cookies from Chrome extension",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://127.0.0.1:8000",
      "type": "string",
      "description": "Base URL of the Laravel app (without trailing slash)"
    },
    {
      "key": "token",
      "value": "",
      "type": "string",
      "description": "Sanctum bearer token. Automatically populated after successful login/register."
    },
    {
      "key": "teacher_id",
      "value": "",
      "type": "string"
    },
    {
      "key": "last_preparation_id",
      "value": "",
      "type": "string"
    },
    {
      "key": "last_content_id",
      "value": "",
      "type": "string"
    }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "item": [
    {
      "name": "🔐 Authentication",
      "item": [
        {
          "name": "Register New Teacher",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"معلم جديد\",\n  \"email\": \"teacher.new@Haddher.sa\",\n  \"password\": \"password123\",\n  \"password_confirmation\": \"password123\",\n  \"phone\": \"0509998887\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/auth/register",
              "host": ["{{base_url}}"],
              "path": ["api", "auth", "register"]
            },
            "description": "Register a new teacher. Creates user + free tier teacher profile and returns token.\n\nResponse includes: user, token, teacher"
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 201 Created', function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "",
                  "pm.test('Response has token', function () {",
                  "    const json = pm.response.json();",
                  "    pm.expect(json).to.have.property('token');",
                  "    pm.collectionVariables.set('token', json.token);",
                  "    console.log('✅ Token saved to collection variables');",
                  "});",
                  "",
                  "pm.test('Response has user and teacher', function () {",
                  "    const json = pm.response.json();",
                  "    pm.expect(json).to.have.property('user');",
                  "    pm.expect(json).to.have.property('token');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"teacher@Haddher.sa\",\n  \"password\": \"password\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/auth/login",
              "host": ["{{base_url}}"],
              "path": ["api", "auth", "login"]
            },
            "description": "Login with existing teacher credentials.\n\nDefault test account (after seeding):\n- Email: teacher@Haddher.sa\n- Password: password\n\nAuto-saves token to collection variables."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200 OK', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('Extract and save token', function () {",
                  "    const json = pm.response.json();",
                  "    if (json.token) {",
                  "        pm.collectionVariables.set('token', json.token);",
                  "        console.log('✅ Token saved:', json.token.substring(0, 10) + '...');",
                  "    }",
                  "    if (json.teacher && json.teacher.id) {",
                  "        pm.collectionVariables.set('teacher_id', json.teacher.id);",
                  "    }",
                  "});",
                  "",
                  "pm.test('Response structure is correct', function () {",
                  "    const json = pm.response.json();",
                  "    pm.expect(json).to.have.property('user');",
                  "    pm.expect(json).to.have.property('token');",
                  "    pm.expect(json).to.have.property('teacher');",
                  "});"
                ]
              }
            }
          ]
        },
