# Signing material never belongs in the repository. android/.gitignore already
# covers the keystore in its own subtree, but a copy at the project root — which
# is where Gradle's storeFile path used to point — slipped past it and was
# committed.
*.jks
*.keystore
key.properties

# A Windows path used on macOS creates a literal "D:" directory of build junk.
D:/
